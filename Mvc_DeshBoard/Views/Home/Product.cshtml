@*<div ng-controller="ProductDetailsInsertController"  class="wrapper" ng-cloak>*@
<div ng-controller="ProductDetailsInsertController"  class="wrapper" ng-cloak>
  
  <!-- Left side column. contains the logo and sidebar -->

  <!-- Content Wrapper. Contains page content -->
  <div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
      <h1>
       New Product
     
      </h1>
      <ol class="breadcrumb">
        <li><a href="#"><i class="fa fa-dashboard"></i> Home</a></li>
        <li class="active">Dashboard</li>
      </ol>
    </section>

    <!-- Main content -->
    <section class="content">
   <div class="row">
      <div class="col">
        <div class="box box-primary">
            <div class="box-header with-border">
              <h3 class="box-title">Add New Product</h3>
            </div>
            <!-- /.box-header -->
            <!-- form start -->
				   <form  novalidate name="f1" ng-submit="SaveData(ProductInsert)">
				   <div class="box-body">
					 <div class="row">
                         <div class="col-md-6 col-sm-6">
                             @*<div class="form-group">
                                 <label>Product Name</label>
                                 <div class="input-group mb-3">

                                     <input type="text" class="form-control" id="exampleInputEmail1" placeholder="Product Name">
                                     <div class="input-group-addon">
                                         <button type="button" data-toggle="modal" data-target="#ModelProduct">Add</button>
                                     </div>
                                 </div>
                             </div>*@
                             <div class="form-group">
                                 <label>Category: </label>
                                 <div custom-select="s as s.CategoryName for s in CategoryList| filter: { CategoryName: $searchTerm }" ng-change="GetCategoryID()" name="uCategoryName" ng-model="CategoryName" ng-class="submitted?'ng-dirty':''" required>
                                     <div class="row" id="custom-select">
                                         <div class="col-sm-12">{{s.CategoryName}}</div>
                                     </div>
                                 </div>
                                 <span class="error col-md-offset-2" ng-show="(f1.uCategoryName.$dirty || submitted) && f1.uCategoryName.$error.required">Category Name required!</span>
                             </div>
                              <div class="form-group">
                                 <label>Product: </label>
                                 <div custom-select="s as s.itemName for s in ProductnameList| filter: { itemName: $searchTerm }" ng-change="GetItemID()" name="uItemName" ng-model="ItemName" ng-class="submitted?'ng-dirty':''" required>
                                     <div class="row" id="custom-select">
                                         <div class="col-sm-12">{{s.itemName}}</div>
                                     </div>
                                 </div>
                                 <span class="error col-md-offset-2" ng-show="(f1.uItemName.$dirty || submitted) && f1.uItemName.$error.required">Product Name required!</span>
                             </div>
                             
                             <div class="form-group">
                                 <label>Supplier Name: </label>
                                 <div custom-select="s as s.SuppName for s in SupplierNameList| filter: { SuppName: $searchTerm }" ng-change="GetSupplierID()" name="uItemName" ng-model="SuppName" ng-class="submitted?'ng-dirty':''" required>
                                     <div class="row" id="custom-select">
                                         <div class="col-sm-12">{{s.SuppName}}</div>
                                     </div>
                                 </div>
                                 <span class="error col-md-offset-2" ng-show="(f1.uItemName.$dirty || submitted) && f1.uItemName.$error.required">Supplier Name required!</span>
                             </div>

                             <div class="form-group">
                                 <label>Product Model: </label>
                                 <div class="input-group mb-3">
                                     <div custom-select="s as s.ModelName for s in ProductModelList| filter: { ModelName: $searchTerm }" name="uModelName" ng-model="ModelName" ng-class="submitted?'ng-dirty':''" required>
                                         <div class="row" id="custom-select">
                                             <div class="col-sm-12">{{s.ModelName}}</div>
                                         </div>
                                     </div>
                                     <div class="input-group-addon">
                                         <button type="button" data-toggle="modal" data-target="#ModelProductContent">Add</button>
                                     </div>
                                     @*<span class="error col-md-offset-2" ng-show="(f1.uModelName.$dirty || submitted) && f1.uModelName.$error.required">Category Name required!</span>*@
                                 </div>
                             </div>

                            @* <div class="form-group">
                                 <label>Model Name</label>
                                 <div class="input-group mb-3">

                                     <input type="text" class="form-control" id="exampleInputEmail1" placeholder="Model Name">
                                     <div class="input-group-addon">
                                         <button type="button" data-toggle="modal" data-target="#ModelProductContent">Add</button>
                                     </div>
                                 </div>
                             </div>*@
                             <div class="form-group">
                                 <label>Description</label>
                                 <textarea class="form-control" rows="2" placeholder="Enter ..." ng-model="ProductInsert.Description"></textarea>
                             </div>

                         </div>
                         <div class="col-md-6 col-sm-6">
                             <div class="form-group">
                                 <label>Quantity</label>
                                 <input type="text" class="form-control" name="uQuantity" ng-model="ProductInsert.Quantity" placeholder="Enter Quantity.." ng-class="submitted?'ng-dirty':''" required>
                                 <span class="error col-md-offset-2" ng-show="(f1.uQuantity.$dirty || submitted) && f1.uQuantity.$error.required">Quantity required!</span>
                             </div>

                             <div class="form-group">
                                 <label>Buy price</label>
                                 <input type="text" class="form-control" name="uBuyPrice" ng-model="ProductInsert.BuyPrice" placeholder="Enter Buy price.." ng-class="submitted?'ng-dirty':''" required>
                                 <span class="error col-md-offset-2" ng-show="(f1.uBuyPrice.$dirty || submitted) && f1.uBuyPrice.$error.required">Buy price required!</span>
                             </div>
                             <div class="form-group">
                                 <label>Sell Price</label>
                                 <input type="text" class="form-control" name="uSellPrice" ng-model="ProductInsert.SellPrice" placeholder="Enter Sell Price.." ng-class="submitted?'ng-dirty':''" required>
                                 <span class="error col-md-offset-2" ng-show="(f1.uSellPrice.$dirty || submitted) && f1.uSellPrice.$error.required">Sell Price required!</span>
                             </div>
                             <div class="form-group">
                                 <label>Date:</label>

                                 <div class="input-group date">
                                     <div class="input-group-addon">
                                         <i class="fa fa-calendar"></i>
                                     </div>
                                     <input type="text" class="form-control pull-right" id="datepicker" ng-model="ProductInsert.InvoiceDate"  date-picker-input>
                                 </div>
                                 <!-- /.input group -->
                             </div>
                             <div class="form-group">
                                 <label>Invoice No</label>
                                 <input type="text" class="form-control" name="uInvoice" ng-model="ProductInsert.Invoice" placeholder="Enter Invoice No.." ng-class="submitted?'ng-dirty':''" required>
                                 @*<span class="error col-md-offset-2" ng-show="(f1.uProductName.$dirty || submitted) && f1.uProductName.$error.required">Product Name required!</span>*@
                             </div>
                             <div class="form-group">
                                 <label for="exampleInputFile">Image</label>
                                 <input type="file" id="exampleInputFile" ng-model="ProductInsert.Image">

                                 <p class="help-block">Example block-level help text here.</p>
                             </div>


                         </div>
				  </div>
	               <div class="form-actions">
				   <center>
						<button type="submit" class="submit btn btn-primary ">
							Submit <i class="icon-angle-right"></i>
						</button>
				   </center>
	               </div>
				   </div>
                       </form>

          </div>
     </div>
   
    </div>

        <!-- /.box -->

          <div class="box">
            <div class="box-header">
              <h3 class="box-title">All Supplier Information</h3>
            </div>
            <!-- /.box-header -->
            <div class="box-body">
              <table  class="table table-bordered table-striped">
                <thead>
                <tr>
                 @* <th>SL No</th>*@
                  <th>Item Name</th>
                  <th>Mpdel name</th>
                  <th>Quantity</th>
                  <th>Buy Price</th>
                  <th>Sell Price</th>
                   <th>Image</th>
                  <th>Invoice </th>
                  <th>Invoice Date</th>
                  <th>Action</th>
                </tr>
                </thead>
                <tbody>
                <tr ng-repeat="r in ProductInfoList |  orderBy: '-itemName' | limitTo:10:10*(page-1)"> 
               @*    <tr ng-repeat="r in ProductInfoList.slice(((currentPage-1)*itemsPerPage), ((currentPage)*itemsPerPage))">*@
                  <td>{{ r.itemName }}</td>
                  <td>{{ r.ModelName }}</td>
                  <td>{{ r.Quantity }}</td>
                  <td>{{ r.BuyPrice }}</td>
                  <td>{{ r.SellPrice }}</td>
                  <td>{{ r.Image }}</td>
                  <td>{{ r.Invoice }}</td>
                  <td>{{r.InvoiceDate.slice(6,-2)|date:'dd-MM-yyyy'}}</td>
                 
                  <td>
                       @*<a ng-class="r.SuppID" href="" data-toggle="modal" data-target="#ModelFabricMill" ng-click="FabricStatus(r)"><span class="badge"  style="background-color:#22849f">Details</span></a></td>*@
                      <button ng-class="r.SuppID" href="" data-toggle="modal" data-target="#ModelProductInfoContent" ng-click="editSupplierStatus(r)" type="button" class="btn btn-primary btn-xs dt-edit" style="margin-right: 5px;">
                          <span class="glyphicon glyphicon-pencil" aria-hidden="true"></span>
                      </button>
                      <button type="button" class="btn btn-danger btn-xs dt-delete" ng-click="DeleteProductInfo(r)">
                          <span class="glyphicon glyphicon-remove" aria-hidden="true"></span>
                      </button>
                  </td>
                </tr>
              
                
                
                </tbody>
                <tfoot>
              @*  <tr>
                  <th>SL No</th>
                  <th>Supplier Name</th>
                  <th>Address</th>
                  <th>Mail</th>
                  <th>Action</th>
                </tr>*@
                </tfoot>
                  <div>
                      View <select ng-model="viewby" ng-change="setItemsPerPage(viewby)"><option>10</option><option>20</option><option>30</option><option>40</option><option>50</option></select> records at a time.
                    @*<uib-pagination class="pagination-sm pagination" total-items="SupplierList.length" ng-model="page"
                    ng-change="pageChanged()" previous-text="&lsaquo;" next-text="&rsaquo;" items-per-page="10"></uib-pagination>*@
 <pagination total-items="totalItems" ng-model="currentPage" max-size="maxSize" class="pagination-sm" boundary-links="true" rotate="false" num-pages="numPages" items-per-page="itemsPerPage"></pagination>
 
                  </div>
                   
              </table>
            </div>
            
               

           
            <!-- /.box-body -->
          </div>
    </section>
    <!-- /.content -->
  </div>
          
  <!-- /.content-wrapper -->
  <footer class="main-footer">
    
    <strong>Copyright &copy; 2018 Arafat Hossan</a>.</strong> All rights
