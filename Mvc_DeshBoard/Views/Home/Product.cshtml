  </footer>

  <!-- Control Sidebar -->

     <form novalidate name="f2" ng-submit="SaveModel(Model)" style="padding: 10px 10px 10px 30px;">
                <div class="modal fade" id="ModelProductContent" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered" role="document">
                        <div class="col-sm-10 col-sm-offset-3">
                            <div class="panel panel-info">

                                <div class="panel-heading" style="text-align: center">
                                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                                    Product Model Add
                                </div>
                                <div class="modal-body">
                                    <div class="form-group">
                                        <label>Category: </label>
                                        <div custom-select="s as s.CategoryName for s in CategoryList_M| filter: { CategoryName: $searchTerm }" ng-change="GetCategoryID_M()" name="uCategoryName" ng-model="M_CategoryName" ng-class="submitted?'ng-dirty':''" required>
                                            <div class="row" id="custom-select">
                                                <div class="col-sm-12">{{s.CategoryName}}</div>
                                            </div>
                                        </div>
                                        <span class="error col-md-offset-2" ng-show="(f1.uCategoryName.$dirty || submitted) && f1.uCategoryName.$error.required">Category Name required!</span>
                                    </div>
                                    <div class="form-group">
                                        <label>Product: </label>
                                        <div custom-select="s as s.itemName for s in ProductnameList_M| filter: { itemName: $searchTerm }" ng-change="GetItemID_M()" name="uItemName" ng-model="M_ItemName" ng-class="submitted?'ng-dirty':''" required>
                                            <div class="row" id="custom-select">
                                                <div class="col-sm-12">{{s.itemName}}</div>
                                            </div>
                                        </div>
                                        <span class="error col-md-offset-2" ng-show="(f1.uItemName.$dirty || submitted) && f1.uItemName.$error.required">Category Name required!</span>
                                    </div>
                                    <div class="form-group">
                                        <label >Model Name</label>
                                        <input type="text" class="form-control" name="uModel" ng-model="Model.ModelName" placeholder="Enter Model Name.." ng-class="submitted?'ng-dirty':''" required>
                                        <span class="error col-md-offset-2" ng-show="(f2.uModel.$dirty || submitted) && f2.uModel.$error.required">Model Name required!</span>

                                    </div>
                                   
                                </div>
                                <div class="modal-footer">
                                    <div class="text-center">
                                        <input type="submit" class="btn btn-primary col-md-offset-2" value="{{submitText2}}" />
                                        @*<button type="button" class="btn btn-primary" data-dismiss="modal">Close</button>*@
                                    </div>

                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </form>
</div>
